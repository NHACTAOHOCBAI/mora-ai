BACKEND_URL=http://localhost:8080
# Shared only by mora-backend and mora-ai; required for the mandatory Admin runtime settings.
AI_SERVICE_INTERNAL_KEY=
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

QDRANT_HOST=localhost
QDRANT_PORT=6333
# Set QDRANT_URL instead of host/port when using a full URL.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Enable only after the backend reindex job completes successfully.
RETRIEVAL_ENABLED=false

BENCHMARK_JUDGE_TIMEOUT=45
BENCHMARK_JUDGE_MAX_RETRIES=1
